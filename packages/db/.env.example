# Runtime connection used by the Prisma Client (app_role -- non-superuser,
# non-table-owner, required for Postgres RLS policies to actually apply).
DATABASE_URL="postgresql://app_role:CHANGE_ME@localhost:5433/prompter?schema=public"

# Migration connection, used only by `prisma migrate`/`db push` (schema-owning
# superuser). Never used at request-serving runtime.
DIRECT_DATABASE_URL="postgresql://prompter:CHANGE_ME@localhost:5433/prompter?schema=public"

# System connection (platform_admin_role, BYPASSRLS). For genuinely
# system-initiated operations with no user session to scope RLS from --
# currently only the Razorpay webhook handler, which must look up a
# CreditPurchase by razorpay_order_id before it knows which org it belongs
# to. Never use this for anything a user-facing request could reach.
SYSTEM_DATABASE_URL="postgresql://platform_admin_role:CHANGE_ME@localhost:5433/prompter?schema=public"

# NOTE: local dev docker-compose.yml maps Postgres to host port 5433, not the
# default 5432 -- avoids clashing with any native Postgres already running
# on the host. Production URLs (Railway) use their own port as usual.
#
# app_role/platform_admin_role have no password by default after migrations
# run -- set one with `ALTER ROLE <role> WITH PASSWORD '...'` (locally via
# docker exec; in staging/prod via the hosting provider's secret-backed
# provisioning step). Never commit a real password to this file or to
# migration SQL.

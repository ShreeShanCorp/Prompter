# Runtime connection used by the Prisma Client (app_role -- non-superuser,
# non-table-owner, required for Postgres RLS policies to actually apply).
DATABASE_URL="postgresql://app_role:CHANGE_ME@localhost:5433/prompter?schema=public"

# Migration connection, used only by `prisma migrate`/`db push` (schema-owning
# superuser). Never used at request-serving runtime.
DIRECT_DATABASE_URL="postgresql://prompter:CHANGE_ME@localhost:5433/prompter?schema=public"

# NOTE: local dev docker-compose.yml maps Postgres to host port 5433, not the
# default 5432 -- avoids clashing with any native Postgres already running
# on the host. Production URLs (Railway) use their own port as usual.
#
# app_role has no password by default after migrations run -- set one with
# `ALTER ROLE app_role WITH PASSWORD '...'` (locally via docker exec; in
# staging/prod via the hosting provider's secret-backed provisioning step).
# Never commit a real password to this file or to migration SQL.

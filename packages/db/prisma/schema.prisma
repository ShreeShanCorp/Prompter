// Schema mirrors docs/architecture/erd.md. RLS policies (docs/architecture/multi-tenancy.md)
// are applied via a raw-SQL migration added alongside the Stage B Phase 2 auth/tenancy work,
// not generated by Prisma itself.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider  = "postgresql"
  // Runtime connection: must be app_role (non-superuser, non-table-owner) so
  // Postgres RLS policies actually apply -- see the app_role migration.
  url       = env("DATABASE_URL")
  // Migrations run as the schema-owning (super)user instead, so DDL works.
  directUrl = env("DIRECT_DATABASE_URL")
}

enum OrgStatus {
  active
  suspended
}

enum PlatformRole {
  none
  platform_admin
}

enum MembershipRole {
  member
  owner
}

enum MembershipStatus {
  invited
  active
  removed
}

enum ProjectStatus {
  draft
  in_progress
  ready_to_export
  exported
  delivered
}

enum ExportFormat {
  md
  docx
  pdf
}

enum CreditSource {
  free_hourly
  purchased
}

enum DeliveryTargetTool {
  claude_code
  codex
  antigravity
  other
}

enum DeliveryMethod {
  copy
  api
  mcp
}

enum DeliveryStatus {
  pending
  success
  failed
}

enum CreditPack {
  starter_1usd_2credits
  value_5usd_20credits
}

enum CreditPurchaseStatus {
  pending
  completed
  failed
}

enum WalletTransactionType {
  purchase_credit
  free_export
  paid_export_debit
}

model Org {
  id             String    @id @default(uuid())
  name           String
  slug           String    @unique
  clerkOrgId     String    @unique @map("clerk_org_id")
  planTier       String    @default("free") @map("plan_tier")
  status         OrgStatus @default(active)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  memberships      OrgMembership[]
  projects         Project[]
  wallet           Wallet?
  creditPurchases  CreditPurchase[]
  walletTxns       WalletTransaction[]
  aiAssistRequests AIAssistRequest[]
  adminAccessLogs  AdminAccessLog[]

  @@map("orgs")
}

model Member {
  id            String       @id @default(uuid())
  clerkUserId   String       @unique @map("clerk_user_id")
  email         String
  name          String?
  platformRole  PlatformRole @default(none) @map("platform_role")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  memberships        OrgMembership[]
  createdProjects     Project[]          @relation("ProjectCreatedBy")
  generatedExports    Export[]           @relation("ExportGeneratedBy")
  initiatedDeliveries DeliveryRecord[]   @relation("DeliveryInitiatedBy")
  creditPurchases     CreditPurchase[]   @relation("CreditPurchasedBy")
  aiAssistRequests    AIAssistRequest[]
  adminAccessLogs     AdminAccessLog[]

  @@map("members")
}

model OrgMembership {
  id        String            @id @default(uuid())
  orgId     String            @map("org_id")
  memberId  String            @map("member_id")
  role      MembershipRole    @default(member)
  status    MembershipStatus  @default(invited)
  invitedBy String?           @map("invited_by")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  org    Org    @relation(fields: [orgId], references: [id])
  member Member @relation(fields: [memberId], references: [id])

  @@unique([orgId, memberId])
  @@map("org_memberships")
}

model Project {
  id              String        @id @default(uuid())
  orgId           String        @map("org_id")
  createdBy       String        @map("created_by")
  name            String
  status          ProjectStatus @default(draft)
  templateVersion String        @map("template_version")
  deletedAt       DateTime?     @map("deleted_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  org             Org               @relation(fields: [orgId], references: [id])
  creator         Member            @relation("ProjectCreatedBy", fields: [createdBy], references: [id])
  templateResponse TemplateResponse?
  exports         Export[]
  deliveryRecords DeliveryRecord[]
  aiAssistRequests AIAssistRequest[]

  @@map("projects")
}

model TemplateResponse {
  id                          String   @id @default(uuid())
  projectId                   String   @unique @map("project_id")
  orgId                       String   @map("org_id")
  sectionIdentity             Json?    @map("section_1_identity")
  sectionRoles                Json?    @map("section_2_roles")
  sectionDomainModel           Json?    @map("section_3_domain_model")
  sectionTechStack            Json?    @map("section_4_tech_stack")
  sectionMvpScope             Json?    @map("section_5_mvp_scope")
  sectionNfr                  Json?    @map("section_6_nfr")
  sectionIntegrations          Json?    @map("section_7_integrations")
  sectionUiUx                 Json?    @map("section_8_ui_ux")
  sectionDod                  Json?    @map("section_9_dod")
  sectionDeliverables          Json?    @map("section_10_deliverables")
  sectionPhaseGate             Json?    @map("section_11_phase_gate")
  sectionSpecialInstructions  String?  @map("section_12_special_instructions")
  completenessPct             Int      @default(0) @map("completeness_pct")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id])

  @@map("template_responses")
}

model Export {
  id           String       @id @default(uuid())
  projectId    String       @map("project_id")
  orgId        String       @map("org_id")
  format       ExportFormat
  fileUrl      String       @map("file_url")
  version      Int
  generatedBy  String       @map("generated_by")
  creditSource CreditSource @map("credit_source")
  createdAt    DateTime     @default(now()) @map("created_at")

  project           Project             @relation(fields: [projectId], references: [id])
  generator         Member              @relation("ExportGeneratedBy", fields: [generatedBy], references: [id])
  deliveryRecords   DeliveryRecord[]
  walletTransactions WalletTransaction[]

  @@map("exports")
}

model DeliveryRecord {
  id            String             @id @default(uuid())
  projectId     String             @map("project_id")
  orgId         String             @map("org_id")
  exportId      String?            @map("export_id")
  targetTool    DeliveryTargetTool @map("target_tool")
  method        DeliveryMethod
  status        DeliveryStatus     @default(pending)
  errorMessage  String?            @map("error_message")
  initiatedBy   String             @map("initiated_by")
  createdAt     DateTime           @default(now()) @map("created_at")

  project   Project @relation(fields: [projectId], references: [id])
  export    Export? @relation(fields: [exportId], references: [id])
  initiator Member  @relation("DeliveryInitiatedBy", fields: [initiatedBy], references: [id])

  @@map("delivery_records")
}

model Wallet {
  id               String    @id @default(uuid())
  orgId            String    @unique @map("org_id")
  balance          Int       @default(0)
  lastFreeExportAt DateTime? @map("last_free_export_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  org             Org                 @relation(fields: [orgId], references: [id])
  creditPurchases CreditPurchase[]
  transactions    WalletTransaction[]

  @@map("wallets")
}

model CreditPurchase {
  id                     String                @id @default(uuid())
  orgId                  String                @map("org_id")
  walletId               String                @map("wallet_id")
  purchasedBy            String                @map("purchased_by")
  pack                   CreditPack
  creditsGranted         Int                   @map("credits_granted")
  amountInr              Decimal               @map("amount_inr") @db.Decimal(10, 2)
  razorpayOrderId        String                @unique @map("razorpay_order_id")
  razorpayPaymentId      String?               @unique @map("razorpay_payment_id")
  status                 CreditPurchaseStatus  @default(pending)
  createdAt              DateTime              @default(now()) @map("created_at")

  org        Org                 @relation(fields: [orgId], references: [id])
  wallet     Wallet              @relation(fields: [walletId], references: [id])
  purchaser  Member              @relation("CreditPurchasedBy", fields: [purchasedBy], references: [id])
  walletTxns WalletTransaction[]

  @@map("credit_purchases")
}

model WalletTransaction {
  id                      String                @id @default(uuid())
  orgId                   String                @map("org_id")
  walletId                String                @map("wallet_id")
  type                    WalletTransactionType
  amount                  Int
  relatedExportId         String?               @map("related_export_id")
  relatedCreditPurchaseId String?               @map("related_credit_purchase_id")
  createdAt               DateTime              @default(now()) @map("created_at")

  org            Org             @relation(fields: [orgId], references: [id])
  wallet         Wallet          @relation(fields: [walletId], references: [id])
  export         Export?         @relation(fields: [relatedExportId], references: [id])
  creditPurchase CreditPurchase? @relation(fields: [relatedCreditPurchaseId], references: [id])

  @@map("wallet_transactions")
}

model AIAssistRequest {
  id         String   @id @default(uuid())
  projectId  String   @map("project_id")
  orgId      String   @map("org_id")
  memberId   String   @map("member_id")
  section    String
  inputText  String   @map("input_text")
  outputText String   @map("output_text")
  model      String
  tokensUsed Int?     @map("tokens_used")
  costUsd    Decimal? @map("cost_usd") @db.Decimal(10, 4)
  createdAt  DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id])
  org     Org     @relation(fields: [orgId], references: [id])
  member  Member  @relation(fields: [memberId], references: [id])

  @@map("ai_assist_requests")
}

model AdminAccessLog {
  id               String   @id @default(uuid())
  platformAdminId  String   @map("platform_admin_id")
  orgId            String   @map("org_id")
  reason           String
  accessedAt       DateTime @default(now()) @map("accessed_at")

  admin Member @relation(fields: [platformAdminId], references: [id])
  org   Org    @relation(fields: [orgId], references: [id])

  @@map("admin_access_log")
}

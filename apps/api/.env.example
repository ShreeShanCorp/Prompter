PORT=3001
DATABASE_URL="postgresql://app_role:CHANGE_ME@localhost:5433/prompter?schema=public"
SYSTEM_DATABASE_URL="postgresql://platform_admin_role:CHANGE_ME@localhost:5433/prompter?schema=public"
REDIS_URL="redis://localhost:6379"

# Clerk (auth)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Razorpay (one-time credit-pack payments -- India-compatible, see
# docs/architecture/requirements-lock.md for why this replaced Stripe)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Anthropic (AI-assist)
ANTHROPIC_API_KEY=

# Resend (payment-receipt email, sent from the Razorpay webhook)
RESEND_API_KEY=
RESEND_FROM_ADDRESS="Prompter <onboarding@resend.dev>"

# Cloudflare R2 (export file storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
